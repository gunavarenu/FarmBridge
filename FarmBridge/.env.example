# --- Supabase (get from supabase.com → project → Settings → API) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...   # Must be a JWT (starts with eyJ), NOT sb_publishable_...

# --- Cloudinary (get from cloudinary.com → dashboard) ---
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=farmbridge_unsigned   # Must be an unsigned preset

# --- Mandi prices (data.gov.in) ---
VITE_DATA_GOV_KEY=579b464db66ec23bdd0000019a699a8d0a3c47c27a7fb2179fe5beea

# --- OTP / Phone Auth (optional — uses mock 123456 if not set) ---
VITE_OTP_API_URL=https://your-otp-backend.vercel.app