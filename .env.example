# --- Supabase (get from supabase.com → project → Settings → API) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# --- Cloudinary (get from cloudinary.com → dashboard) ---
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=farmbridge_unsigned   # Must be an unsigned preset

# --- Mandi prices (data.gov.in) ---
VITE_DATA_GOV_KEY=your_data_gov_api_key

# --- OTP / Phone Auth (configure a real server-side OTP provider before production) ---
VITE_OTP_API_URL=https://your-otp-backend.vercel.app